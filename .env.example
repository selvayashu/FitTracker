# Browser-safe (shipped to the client). Prefix VITE_ is required by Vite.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (Cloudflare Worker / Pages Function secrets). NEVER prefix with VITE_.
# Phase 2+
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Random string (32+ chars) used to sign the OAuth state parameter
STRAVA_STATE_SECRET=
SUPABASE_ANON_KEY=your-anon-key
# Phase 4
RESEND_API_KEY=
