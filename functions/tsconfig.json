{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types"],
    "baseUrl": "..",
    "paths": { "@fittrack/shared": ["packages/shared/src/index.ts"] }
  },
  "include": ["./**/*.ts", "../packages/shared/src/**/*.ts"],
  "exclude": ["../packages/shared/src/**/*.test.ts", "./**/*.test.ts"]
}
